{
  "expo": {
    "name": "Yaiki Accesorios",
    "slug": "yaiki-accesorios",
    "owner": "zanacode",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "yaiki",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zanacode.yaiki",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D88CAC",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.yaiki.accesorios"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Yaiki necesita acceso a tus fotos para subir imágenes de productos.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Permite el uso de Face ID para proteger tu sesión de administrador."
        }
      ],
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#D88CAC"
        }
      ],
      "./plugins/withSceneLifecycle"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ce679f7c-4f15-46d7-bb4f-553ccc6080cb"
      }
    }
  }
}
