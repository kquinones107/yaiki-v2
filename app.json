{
  "expo": {
    "name": "Yaiki Accesorios",
    "slug": "yaiki-accesorios",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "yaiki",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yaiki.accesorios"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a0a2e",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.yaiki.accesorios"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Yaiki necesita acceso a tus fotos para subir imágenes de productos."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Permite el uso de Face ID para proteger tu sesión de administrador."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
